{
  "name": "ask-my-files",
  "version": "0.1.2",
  "private": true,
  "description": "Explorer-aware local file assistant",
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "helper": "dotnet publish helper/ExplorerBridge.csproj -c Release -r win-x64 --self-contained true -o helper/publish",
    "package:win": "npm run helper && npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "fast-xml-parser": "^5.3.0",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "44.4.5",
    "electron-builder": "^26.0.12",
    "jsdom": "^30.1.1",
    "vite": "^7.1.7"
  },
  "build": {
    "appId": "com.askmyfiles.desktop",
    "productName": "Ask My Files",
    "asar": true,
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "helper/publish",
        "to": "helper"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "release"
    }
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
